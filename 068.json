3","ar":"خَٰشِعَةً أَبۡصَٰرُهُمۡ تَرۡهَقُهُمۡ ذِلَّةࣱۖ وَقَدۡ كَانُواْ يُدۡعَوۡنَ إِلَى ٱلسُّجُودِ وَهُمۡ سَٰلِمُونَ","s":"خاشعه ابصارهم ترهقهم ذله وقد كانوا يدعون الي السجود وهم سالمون","w":[{"i":1,"ar":"خَٰشِعَةً"},{"i":2,"ar":"أَبۡصَٰرُهُمۡ"},{"i":3,"ar":"تَرۡهَقُهُمۡ"},{"i":4,"ar":"ذِلَّةࣱۖ"},{"i":5,"ar":"وَقَدۡ"},{"i":6,"ar":"كَانُواْ"},{"i":7,"ar":"يُدۡعَوۡنَ"},{"i":8,"ar":"إِلَى"},{"i":9,"ar":"ٱلسُّجُودِ"},{"i":10,"ar":"وَهُمۡ"},{"i":11,"ar":"سَٰلِمُونَ"}]},{"k":"68:44","ar":"فَذَرۡنِي وَمَن يُكَذِّبُ بِهَٰذَا ٱلۡحَدِيثِۖ سَنَسۡتَدۡرِجُهُم مِّنۡ حَيۡثُ لَا يَعۡلَمُونَ","s":"فذرني ومن يكذب بهذا الحديث سنستدرجهم من حيث لا يعلمون","w":[{"i":1,"ar":"فَذَرۡنِي"},{"i":2,"ar":"وَمَن"},{"i":3,"ar":"يُكَذِّبُ"},{"i":4,"ar":"بِهَٰذَا"},{"i":5,"ar":"ٱلۡحَدِيثِۖ"},{"i":6,"ar":"سَنَسۡتَدۡرِجُهُم"},{"i":7,"ar":"مِّنۡ"},{"i":8,"ar":"حَيۡثُ"},{"i":9,"ar":"لَا"},{"i":10,"ar":"يَعۡلَمُونَ"}]},{"k":"68:45","ar":"وَأُمۡلِي لَهُمۡۚ إِنَّ كَيۡدِي مَتِينٌ","s":"واملي لهم ان كيدي متين","w":[{"i":1,"ar":"وَأُمۡلِي"},{"i":2,"ar":"لَهُمۡۚ"},{"i":3,"ar":"إِنَّ"},{"i":4,"ar":"كَيۡدِي"},{"i":5,"ar":"مَتِينٌ"}]},{"k":"68:46","ar":"أَمۡ تَسۡـَٔلُهُمۡ أَجۡرࣰ ا فَهُم مِّن مَّغۡرَمࣲ مُّثۡقَلُونَ","s":"ام تسالهم اجرا فهم من مغرم مثقلون","w":[{"i":1,"ar":"أَمۡ"},{"i":2,"ar":"تَسۡـَٔلُهُمۡ"},{"i":3,"ar":"أَجۡرࣰ"},{"i":4,"ar":"ا"},{"i":5,"ar":"فَهُم"},{"i":6,"ar":"مِّن"},{"i":7,"ar":"مَّغۡرَمࣲ"},{"i":8,"ar":"مُّثۡقَلُونَ"}]},{"k":"68:47","ar":"أَمۡ عِندَهُمُ ٱلۡغَيۡبُ فَهُمۡ يَكۡتُبُونَ","s":"ام عندهم الغيب فهم يكتبون","w":[{"i":1,"ar":"أَمۡ"},{"i":2,"ar":"عِندَهُمُ"},{"i":3,"ar":"ٱلۡغَيۡبُ"},{"i":4,"ar":"فَهُمۡ"},{"i":5,"ar":"يَكۡتُبُونَ"}]},{"k":"68:48","ar":"فَٱصۡبِرۡ لِحُكۡمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلۡحُوتِ إِذۡ نَادَىٰ وَهُوَ مَكۡظُومࣱ‏","s":"فاصبر لحكم ربك ولا تكن كصاحب الحوت اذ نادي وهو مكظوم","w":[{"i":1,"ar":"فَٱصۡبِرۡ"},{"i":2,"ar":"لِحُكۡمِ"},{"i":3,"ar":"رَبِّكَ"},{"i":4,"ar":"وَلَا"},{"i":5,"ar":"تَكُن"},{"i":6,"ar":"كَصَاحِبِ"},{"i":7,"ar":"ٱلۡحُوتِ"},{"i":8,"ar
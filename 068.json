{"id":68,"verses":[{"k":"68:1","ar":"نٓۚ وَٱلۡقَلَمِ وَمَا يَسۡطُرُونَ","s":"بسم الله الرحمن الرحيم ن والقلم وما يسطرون","w":[{"i":1,"ar":"نٓۚ"},{"i":2,"ar":"وَٱلۡقَلَمِ"},{"i":3,"ar":"وَمَا"},{"i":4,"ar":"يَسۡطُرُونَ"}]},{"k":"68:2","ar":"مَآ أَنتَ بِنِعۡمَةِ رَبِّكَ بِمَجۡنُونࣲ‏","s":"ما انت بنعمه ربك بمجنون","w":[{"i":1,"ar":"مَآ"},{"i":2,"ar":"أَنتَ"},{"i":3,"ar":"بِنِعۡمَةِ"},{"i":4,"ar":"رَبِّكَ"},{"i":5,"ar":"بِمَجۡنُونࣲ‏"}]},{"k":"68:3","ar":"وَإِنَّ لَكَ لَأَجۡرًا غَيۡرَ مَمۡنُونࣲ‏","s":"وان لك لاجرا غير ممنون","w":[{"i":1,"ar":"وَإِنَّ"},{"i":2,"ar":"لَكَ"},{"i":3,"ar":"لَأَجۡرًا"},{"i":4,"ar":"غَيۡرَ"},{"i":5,"ar":"مَمۡنُونࣲ‏"}]},{"k":"68:4","ar":"وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمࣲ‏","s":"وانك لعلي خلق عظيم","w":[{"i":1,"ar":"وَإِنَّكَ"},{"i":2,"ar":"لَعَلَىٰ"},{"i":3,"ar":"خُلُقٍ"},{"i":4,"ar":"عَظِيمࣲ‏"}]},{"k":"68:5","ar":"فَسَتُبۡصِرُ وَيُبۡصِرُونَ","s":"فستبصر ويبصرون","w":[{"i":1,"ar":"فَسَتُبۡصِرُ"},{"i":2,"ar":"وَيُبۡصِرُونَ"}]},{"k":"68:6","ar":"بِأَييِّكُمُ ٱلۡمَفۡتُونُ","s":"باييكم المفتون","w":[{"i":1,"ar":"بِأَييِّكُمُ"},{"i":2,"ar":"ٱلۡمَفۡتُونُ"}]},{"k":"68:7","ar":"إِنَّ رَبَّكَ هُوَ أَعۡلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعۡلَمُ بِٱلۡمُهۡتَدِينَ","s":"ان ربك هو اعلم بمن ضل عن سبيله وهو اعلم بالمهتدين","w":[{"i":1,"ar":"إِنَّ"},{"i":2,"ar":"رَبَّكَ"},{"i":3,"ar":"هُوَ"},{"i":4,"ar":"أَعۡلَمُ"},{"i":5,"ar":"بِمَن"},{"i":6,"ar":"ضَلَّ"},{"i":7,"ar":"عَن"},{"i":8,"ar":"سَبِيلِهِۦ"},{"i":9,"ar":"وَهُوَ"},{"i":10,"ar":"أَعۡلَمُ"},{"i":11,"ar":"بِٱلۡمُهۡتَدِينَ"}]},{"k":"68:8","ar":"فَلَا تُطِعِ ٱلۡمُكَذِّبِينَ","s":"فلا تطع المكذبين","w":[{"i":1,"ar":"فَلَا"},{"i":2,"ar":"تُطِعِ"},{"i":3,"ar":"ٱلۡمُكَذِّبِينَ"}]},{"k":"68:9","ar":"وَدُّواْ لَوۡ تُدۡهِنُ فَيُدۡهِنُونَ","s":"ودوا لو تدهن فيدهنون","w":[{"i":1,"ar":"وَدُّواْ"},{"i":2,"ar":"لَوۡ"},{"i":3,"ar":"تُدۡهِنُ"},{"i":4,"ar":"فَيُدۡهِنُونَ"}]},{"k":"68:10","ar":"وَلَا تُطِعۡ كُلَّ حَلَّافࣲ مَّهِينٍ","s":"ولا تطع كل حلاف مهين","w":[{"i":1,"ar":"وَلَا"},{"i":2,"ar":"تُطِع
{"root": "3-k-b-a-sh", "root_ar": "عكباش", "quranic": false, "quran_frequency": null, "summary": null, "lane": null, "lane_match_type": null, "classical": [{"id": "qamus", "name": "al-Qamus al-Muhit", "name_ar": "القاموس المحيط", "compiler": "Majd al-Din al-Fayruzabadi", "died": 1414, "tier": "general", "source": "OpenITI Shamela0007283-ara1 (Muassasat al-Risala)", "match_type": "root", "entries": [{"headword": "العكباش", "text": "العكباش، بالكسر، من الظباء: ما يطلع قرنه أولا قبل أن يطول. والعكبشة: الشد الوثيق. وتعكبش فيه الغصن: نشب فيه بشوكه."}]}], "cap": null}
{"root": "b-q-n", "root_ar": "بقن", "quranic": false, "quran_frequency": null, "summary": null, "lane": null, "lane_match_type": null, "classical": [{"id": "tahdhib", "name": "Tahdhib al-Lugha", "name_ar": "تهذيب اللغة", "compiler": "al-Azhari", "died": 980, "tier": "general", "source": "OpenITI Shamela0007031-ara1", "match_type": "root", "entries": [{"headword": "بقن", "text": "بقن: أما بقن: فإن الليث أهمله. وروى أبو العباس عن ابن الأعرابي: أبقن الرجل: إذا خصب جنابه واخضرت فعاله."}]}, {"id": "lisan", "name": "Lisan al-Arab", "name_ar": "لسان العرب", "compiler": "Ibn Manzur", "died": 1311, "tier": "general", "source": "wizsk/arabic_lexicons SQLite", "match_type": "root", "entries": [{"headword": "بقن", "text": "بقن: الأَزهري: أَما بَقَنَ فَإِنَّ اللَّيْثَ أَهمله، وَرَوَى ثَعْلَبٌ عَنِ ابْنِ الأَعرابي: أَبْقَن إِذَا أَخصَبَ جَنابُه واخضرَّت نِعالُه. والنِّعالُ: الأَرضون الصُّلبة."}]}, {"id": "qamus", "name": "al-Qamus al-Muhit", "name_ar": "القاموس المحيط", "compiler": "Majd al-Din al-Fayruzabadi", "died": 1414, "tier": "general", "source": "OpenITI Shamela0007283-ara1 (Muassasat al-Risala)", "match_type": "root", "entries": [{"headword": "أبقن", "text": "أبقن: أخصب جنابه. وأحمد بن بقنة، محركة والنون مشددة: وزير العلويين من بني حمود بالأندلس."}]}], "cap": null}
{"root": "d6-d-n", "root_ar": "ضدن", "quranic": false, "quran_frequency": null, "summary": null, "lane": null, "lane_match_type": null, "classical": [{"id": "tahdhib", "name": "Tahdhib al-Lugha", "name_ar": "تهذيب اللغة", "compiler": "al-Azhari", "died": 980, "tier": "general", "source": "OpenITI Shamela0007031-ara1", "match_type": "root", "entries": [{"headword": "ضدن", "text": "ضدن: أما ضدن فإن الليث أهمله. وقال ابن دريد: ضدنت الشيء ضدنا: إذا أصلحته وسهلته، لغة يمانية، تفرد به."}]}, {"id": "lisan", "name": "Lisan al-Arab", "name_ar": "لسان العرب", "compiler": "Ibn Manzur", "died": 1311, "tier": "general", "source": "wizsk/arabic_lexicons SQLite", "match_type": "root", "entries": [{"headword": "ضدن", "text": "ضدن: ضَدَنْتُ الشيءَ أَضْدِنُه ضَدْناً: سَهَّلْتُه وأَصلحته، لُغَةٌ يَمَانِيَةٌ، وضَدَنَى، عَلَى مِثَالِ جَمَزى: موضع."}]}, {"id": "qamus", "name": "al-Qamus al-Muhit", "name_ar": "القاموس المحيط", "compiler": "Majd al-Din al-Fayruzabadi", "died": 1414, "tier": "general", "source": "OpenITI Shamela0007283-ara1 (Muassasat al-Risala)", "match_type": "root", "entries": [{"headword": "ضدنه", "text": "ضدنه يضدنه: أصلحه، وسهله. وضدنى، كسكرى: ع. وضدوان وضديان: جبلان، أو النون زائدة، فيعاد في الياء."}]}], "cap": null}
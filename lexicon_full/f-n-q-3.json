{"root": "f-n-q-3", "root_ar": "فنقع", "quranic": false, "quran_frequency": null, "summary": null, "lane": null, "lane_match_type": null, "classical": [{"id": "lisan", "name": "Lisan al-Arab", "name_ar": "لسان العرب", "compiler": "Ibn Manzur", "died": 1311, "tier": "general", "source": "wizsk/arabic_lexicons SQLite", "match_type": "root", "entries": [{"headword": "فنقع", "text": "فنقع: الأَزهري: مِنْ أَسماء الفأْر الفُنْقُعُ، الْفَاءُ قَبْلَ الْقَافِ، قَالَ: والفِرْنِبُ مِثْلُهُ. والفُنْقُعةُ والقُنْفُعةُ جَمِيعًا: الاسْتُ؛ كلتاهما عن كراع."}]}, {"id": "qamus", "name": "al-Qamus al-Muhit", "name_ar": "القاموس المحيط", "compiler": "Majd al-Din al-Fayruzabadi", "died": 1414, "tier": "general", "source": "OpenITI Shamela0007283-ara1 (Muassasat al-Risala)", "match_type": "root", "entries": [{"headword": "الفنقع", "text": "الفنقع، كقنفذ: الفأرة، وقد تقدم القاف، وبهاء: الاست، ويفتح. وكجعفر: الموت."}]}], "cap": null}
{"root": "f-n-sh-kh", "root_ar": "فنشخ", "quranic": false, "quran_frequency": null, "summary": null, "lane": null, "lane_match_type": null, "classical": [{"id": "lisan", "name": "Lisan al-Arab", "name_ar": "لسان العرب", "compiler": "Ibn Manzur", "died": 1311, "tier": "general", "source": "wizsk/arabic_lexicons SQLite", "match_type": "root", "entries": [{"headword": "فنشخ", "text": "فنشخ: التَّهْذِيبُ: يُقَالُ فَنْشَخَه فِنْشاخاً وَزَلْزَلَهُ زِلْزَالًا بِمَعْنًى واحد."}]}, {"id": "qamus", "name": "al-Qamus al-Muhit", "name_ar": "القاموس المحيط", "compiler": "Majd al-Din al-Fayruzabadi", "died": 1414, "tier": "general", "source": "OpenITI Shamela0007283-ara1 (Muassasat al-Risala)", "match_type": "root", "entries": [{"headword": "الفنشخة", "text": "الفنشخة: الإعياء، والتأخر عن الأمر، والتفحيج بين الرجلين عند البول، وأن يكبر الرجل ويشيخ. والمفنشخ: الساقط النائم. وتفنشخت المرأة في الجماع: باعدت بين رجليها. وفنشخ: علم."}]}], "cap": null}
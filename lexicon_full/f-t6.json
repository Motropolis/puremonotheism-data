{"root": "f-t6", "root_ar": "فط", "quranic": false, "quran_frequency": null, "summary": null, "lane": null, "lane_match_type": null, "classical": [{"id": "tahdhib", "name": "Tahdhib al-Lugha", "name_ar": "تهذيب اللغة", "compiler": "al-Azhari", "died": 980, "tier": "general", "source": "OpenITI Shamela0007031-ara1", "match_type": "root", "entries": [{"headword": "فط", "text": "فط: أهمله الليث. وروى أبو العباس عن ابن الأعرابي أنه قال: فطفط الرجل: إذا لم يفهم كلامه. قال: والأفط: الأفطس."}]}, {"id": "qamus", "name": "al-Qamus al-Muhit", "name_ar": "القاموس المحيط", "compiler": "Majd al-Din al-Fayruzabadi", "died": 1414, "tier": "general", "source": "OpenITI Shamela0007283-ara1 (Muassasat al-Risala)", "match_type": "root", "entries": [{"headword": "الأفط", "text": "الأفط: الأفطس. والفطوطى، كخجوجى: الرجل الأفزر الظهر. والفطافط: الأصوات عند الزجر والجماع. وفطفط: سلح، وتكلم بكلام لا يفهم."}]}], "cap": null}
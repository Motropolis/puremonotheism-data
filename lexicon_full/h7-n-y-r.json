{"root": "h7-n-y-r", "root_ar": "حنير", "quranic": false, "quran_frequency": null, "summary": null, "lane": null, "lane_match_type": null, "classical": [{"id": "qamus", "name": "al-Qamus al-Muhit", "name_ar": "القاموس المحيط", "compiler": "Majd al-Din al-Fayruzabadi", "died": 1414, "tier": "general", "source": "OpenITI Shamela0007283-ara1 (Muassasat al-Risala)", "match_type": "root", "entries": [{"headword": "الحنيرة", "text": "الحنيرة: عقد الطاق المبني، والقوس، أو بلا وتر، والعقد المضروب ليس بذلك العريض، ومندفة للنساء يندف بها القطن. والحنورة، كسنورة: دويبة. وحنرها: ثناها."}]}], "cap": null}
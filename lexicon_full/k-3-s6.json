{"root": "k-3-s6", "root_ar": "كعص", "quranic": false, "quran_frequency": null, "summary": null, "lane": null, "lane_match_type": null, "classical": [{"id": "tahdhib", "name": "Tahdhib al-Lugha", "name_ar": "تهذيب اللغة", "compiler": "al-Azhari", "died": 980, "tier": "general", "source": "OpenITI Shamela0007031-ara1", "match_type": "root", "entries": [{"headword": "كعص", "text": "كعص: قال بعضهم: الكعص: اللئيم. قلت: ولا أعرفه أنا. استعمل من وجوهه: عكس، سكع، كسع، عسك."}]}, {"id": "lisan", "name": "Lisan al-Arab", "name_ar": "لسان العرب", "compiler": "Ibn Manzur", "died": 1311, "tier": "general", "source": "wizsk/arabic_lexicons SQLite", "match_type": "root", "entries": [{"headword": "كعص", "text": "كعص: الكَعِيصُ: صَوْتُ الفَأْرة والفَرْخِ. وكَعَصَ الطعامَ: أَكلَه؛ وَقِيلَ: عيْنه بَدَلٌ مِنْ هَمْزَةِ كأَصَه وَمَعْنَاهُمَا وَاحِدٌ. قَالَ الأَزهري: قَالَ بَعْضُهُمْ الكَعْصُ اللَّئِيمُ: قَالَ: وَلَا أَعرفه."}]}, {"id": "qamus", "name": "al-Qamus al-Muhit", "name_ar": "القاموس المحيط", "compiler": "Majd al-Din al-Fayruzabadi", "died": 1414, "tier": "general", "source": "OpenITI Shamela0007283-ara1 (Muassasat al-Risala)", "match_type": "root", "entries": [{"headword": "الكعص", "text": "الكعص، كالمنع: الأكل، لغة في الكأص. وكعيص الفأر والفرخ: أصواتهما."}]}], "cap": null}
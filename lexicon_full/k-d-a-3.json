{"root": "k-d-a-3", "root_ar": "كداع", "quranic": false, "quran_frequency": null, "summary": null, "lane": null, "lane_match_type": null, "classical": [{"id": "qamus", "name": "al-Qamus al-Muhit", "name_ar": "القاموس المحيط", "compiler": "Majd al-Din al-Fayruzabadi", "died": 1414, "tier": "general", "source": "OpenITI Shamela0007283-ara1 (Muassasat al-Risala)", "match_type": "root", "entries": [{"headword": "الكداع", "text": "الكداع، ككتاب: جد لمعشر بن مالك بن عوف الذي قتل مع الحسين بالطف. وكدعه، كمنعه: دفعه. والكدعة، بالضم: الذليل. كربعه: صرعه، و الشيء بالسيف: قطعه، و قوائمه: أبانها."}]}], "cap": null}
{"root": "l-kh-3", "root_ar": "لخع", "quranic": false, "quran_frequency": null, "summary": null, "lane": null, "lane_match_type": null, "classical": [{"id": "maqayis", "name": "Maqayis al-Lugha", "name_ar": "مقاييس اللغة", "compiler": "Ibn Faris", "died": 1004, "tier": "root-semantic", "source": "wizsk/arabic_lexicons SQLite", "match_type": "root", "entries": [{"headword": "لخع", "text": "(لَخَعَ) اللَّامُ وَالْخَاءُ وَالْعَيْنُ كَلِمَةٌ وَاحِدَةٌ. قَالَ ابْنُ دُرَيْدٍ: اللَّخَعُ: اسْتِرْخَاءٌ فِي الْجِسْمِ."}]}, {"id": "lisan", "name": "Lisan al-Arab", "name_ar": "لسان العرب", "compiler": "Ibn Manzur", "died": 1311, "tier": "general", "source": "wizsk/arabic_lexicons SQLite", "match_type": "root", "entries": [{"headword": "لخع", "text": "لخع: اللَّخْعُ: اسْتِرْخاءُ الْجِسْمِ، يَمَانِيَّةٌ، واللَّخِيعةُ: اسْمٌ مُشْتَقٌّ منه. ويَلْخَعُ: موضع."}]}, {"id": "qamus", "name": "al-Qamus al-Muhit", "name_ar": "القاموس المحيط", "compiler": "Majd al-Din al-Fayruzabadi", "died": 1414, "tier": "general", "source": "OpenITI Shamela0007283-ara1 (Muassasat al-Risala)", "match_type": "root", "entries": [{"headword": "اللخع", "text": "اللخع، محركة: استرخاء الجسم. وذو الشناتر لخيعة بن ينوف: من حمير. ويلخع، كيمنع: ع باليمن، أو هو بالباء الموحدة."}]}], "cap": null}
{"root": "q-b-3-th", "root_ar": "قبعث", "quranic": false, "quran_frequency": null, "summary": null, "lane": null, "lane_match_type": null, "classical": [{"id": "lisan", "name": "Lisan al-Arab", "name_ar": "لسان العرب", "compiler": "Ibn Manzur", "died": 1311, "tier": "general", "source": "wizsk/arabic_lexicons SQLite", "match_type": "root", "entries": [{"headword": "قبعث", "text": "قبعث: جملٌ قَبَعْثَى: ضَخْمُ الفَراسِنِ، قَبيحُها؛ والأُنثى، بِالْهَاءِ، ناقةٌ قَبَعْثاة فِي نوقٍ قَباعِثَ. وَرَجُلٌ قَبَعْثى: عَظِيمُ القَدَم."}]}, {"id": "qamus", "name": "al-Qamus al-Muhit", "name_ar": "القاموس المحيط", "compiler": "Majd al-Din al-Fayruzabadi", "died": 1414, "tier": "general", "source": "OpenITI Shamela0007283-ara1 (Muassasat al-Risala)", "match_type": "root", "entries": [{"headword": "القبعثى", "text": "القبعثى، كشمردى: العظيم القدم منا، والضخم الفراسن من الجمال، وهي بهاء. والقبعثاة: عفل المرأة."}]}], "cap": null}
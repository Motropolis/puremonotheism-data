{"root": "q-q", "root_ar": "قق", "quranic": false, "quran_frequency": null, "summary": null, "lane": null, "lane_match_type": null, "classical": [{"id": "qamus", "name": "al-Qamus al-Muhit", "name_ar": "القاموس المحيط", "compiler": "Majd al-Din al-Fayruzabadi", "died": 1414, "tier": "general", "source": "OpenITI Shamela0007283-ara1 (Muassasat al-Risala)", "match_type": "root", "entries": [{"headword": "القققة", "text": "القققة، محركة: الغربان الأهلية، وحدث الصبي، كالققة، مشددة وتكسر. ووقع في ققة: في رأي سوء. أو حدث الصبي: ققة، كبقة. أو ققة، كثقة: صوت يصوت به الصبي، أو يصوت به إذا فزع."}]}], "cap": null}
{"root": "q-r-f-3", "root_ar": "قرفع", "quranic": false, "quran_frequency": null, "summary": null, "lane": null, "lane_match_type": null, "classical": [{"id": "lisan", "name": "Lisan al-Arab", "name_ar": "لسان العرب", "compiler": "Ibn Manzur", "died": 1311, "tier": "general", "source": "wizsk/arabic_lexicons SQLite", "match_type": "root", "entries": [{"headword": "قرفع", "text": "قرفع: تَقَرْعَفَ الرجلُ واقْرَعَفَّ وتَقَرْفَعَ: تَقَبَّضَ. والقُرْفُعةُ: الاسْتُ؛ عَنْ كُرَاعٍ. وَيُقَالُ: الفُرْقُعةُ، بِتَقْدِيمِ الْفَاءِ، وَيُقَالُ لِلِاسْتِ القُنْفُعةُ والفُنْقُعةُ."}]}, {"id": "qamus", "name": "al-Qamus al-Muhit", "name_ar": "القاموس المحيط", "compiler": "Majd al-Din al-Fayruzabadi", "died": 1414, "tier": "general", "source": "OpenITI Shamela0007283-ara1 (Muassasat al-Risala)", "match_type": "root", "entries": [{"headword": "تقرفع", "text": "تقرفع: تقبض، كتقرعف. واقرنفع عليه، مبنيا للمفعول: أغمي عليه ثم أفاق."}]}], "cap": null}
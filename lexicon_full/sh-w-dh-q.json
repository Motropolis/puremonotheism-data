{"root": "sh-w-dh-q", "root_ar": "شوذق", "quranic": false, "quran_frequency": null, "summary": null, "lane": null, "lane_match_type": null, "classical": [{"id": "qamus", "name": "al-Qamus al-Muhit", "name_ar": "القاموس المحيط", "compiler": "Majd al-Din al-Fayruzabadi", "died": 1414, "tier": "general", "source": "OpenITI Shamela0007283-ara1 (Muassasat al-Risala)", "match_type": "root", "entries": [{"headword": "الشوذق", "text": "الشوذق، كجوهر، والذال معجمة: السوار. والشيذق والشيذقان (والشيذاق) والشوذانق: الصقر، أو الشاهين، وضبط لغاتها في السين. والشوذقة: أن تأخذ بأصابعك شيئا كالصقر."}]}], "cap": null}
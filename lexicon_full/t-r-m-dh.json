{"root": "t-r-m-dh", "root_ar": "ترمذ", "quranic": false, "quran_frequency": null, "summary": null, "lane": null, "lane_match_type": null, "classical": [{"id": "lisan", "name": "Lisan al-Arab", "name_ar": "لسان العرب", "compiler": "Ibn Manzur", "died": 1311, "tier": "general", "source": "wizsk/arabic_lexicons SQLite", "match_type": "root", "entries": [{"headword": "ترمذ", "text": "ترمذ: تِرمِذُ، بِكَسْرِ التَّاءِ وَالْمِيمِ: الْبَلَدُ الْمَعْرُوفُ بِخُرَاسَانَ."}]}, {"id": "qamus", "name": "al-Qamus al-Muhit", "name_ar": "القاموس المحيط", "compiler": "Majd al-Din al-Fayruzabadi", "died": 1414, "tier": "general", "source": "OpenITI Shamela0007283-ara1 (Muassasat al-Risala)", "match_type": "root", "entries": [{"headword": "ترمذ", "text": "ترمذ، كإثمد: ة ببخارى. ابن السمعاني: وأهل المعرفة يضمون التاء والميم، والمتداول على لسان أهلها فتح التاء وكسر الميم، وبعضهم يفتح التاء، وبعضهم يضمها، وبعضهم يكسرها) ."}]}], "cap": null}
{"root": "t6-3-l", "root_ar": "طعل", "quranic": false, "quran_frequency": null, "summary": null, "lane": null, "lane_match_type": null, "classical": [{"id": "tahdhib", "name": "Tahdhib al-Lugha", "name_ar": "تهذيب اللغة", "compiler": "al-Azhari", "died": 980, "tier": "general", "source": "OpenITI Shamela0007031-ara1", "match_type": "root", "entries": [{"headword": "طعل", "text": "طعل: أهمل الليث طعل. وروى أبو عمر عن ثعلب عن ابن الأعرابي قال: الطاعل: السهم المقوم. والطعل: القدح في الأنساب. قلت: وهما حرفان غريبان لم أسمعهما لغيره."}]}, {"id": "lisan", "name": "Lisan al-Arab", "name_ar": "لسان العرب", "compiler": "Ibn Manzur", "died": 1311, "tier": "general", "source": "wizsk/arabic_lexicons SQLite", "match_type": "root", "entries": [{"headword": "طعل", "text": "طعل: ابْنُ الأَعرابي: الطاعِل السَّهْم المُقَوَّم. والطَّعْل: القَدْح فِي الأَنساب؛ قَالَ الأَزهري: وَهَذَانِ حَرْفَانِ غَرِيبَانِ لَمْ أسمعهما لغيره."}]}, {"id": "qamus", "name": "al-Qamus al-Muhit", "name_ar": "القاموس المحيط", "compiler": "Majd al-Din al-Fayruzabadi", "died": 1414, "tier": "general", "source": "OpenITI Shamela0007283-ara1 (Muassasat al-Risala)", "match_type": "root", "entries": [{"headword": "الطعل", "text": "الطعل كالمنع: الطعن في الأنساب. والطاعل: السهم المقوم."}]}], "cap": null}
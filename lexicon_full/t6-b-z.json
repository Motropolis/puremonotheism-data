{"root": "t6-b-z", "root_ar": "طبز", "quranic": false, "quran_frequency": null, "summary": null, "lane": null, "lane_match_type": null, "classical": [{"id": "tahdhib", "name": "Tahdhib al-Lugha", "name_ar": "تهذيب اللغة", "compiler": "al-Azhari", "died": 980, "tier": "general", "source": "OpenITI Shamela0007031-ara1", "match_type": "root", "entries": [{"headword": "طبز", "text": "طبز: أهمله الليث، وروى عمرو عن أبيه قال: الطبز: ركن الجبل. والطبز: الجمل: ذو السنامين الهائج. وقال غيره: طبز فلان جاريته طبزا: إذا جامعها."}]}, {"id": "lisan", "name": "Lisan al-Arab", "name_ar": "لسان العرب", "compiler": "Ibn Manzur", "died": 1311, "tier": "general", "source": "wizsk/arabic_lexicons SQLite", "match_type": "root", "entries": [{"headword": "طبز", "text": "طبز: أَبو عَمْرٍو: الطِّبْزُ رُكْنُ الْجَبَلِ. والطِّبْز: الجَمَلُ ذُو السَّنامين الهائجُ. وطَبَزَ فلانٌ جاريَتَه طَبْزاً: جَامَعَهَا."}]}, {"id": "qamus", "name": "al-Qamus al-Muhit", "name_ar": "القاموس المحيط", "compiler": "Majd al-Din al-Fayruzabadi", "died": 1414, "tier": "general", "source": "OpenITI Shamela0007283-ara1 (Muassasat al-Risala)", "match_type": "root", "entries": [{"headword": "الطبز", "text": "الطبز، بالكسر: ركن الجبل، والجمل ذو السنامين. وطبزها: جامعها. والطبز: الملء لكل شيء."}]}], "cap": null}
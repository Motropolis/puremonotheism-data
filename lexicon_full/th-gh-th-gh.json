{"root": "th-gh-th-gh", "root_ar": "ثغثغ", "quranic": false, "quran_frequency": null, "summary": null, "lane": null, "lane_match_type": null, "classical": [{"id": "qamus", "name": "al-Qamus al-Muhit", "name_ar": "القاموس المحيط", "compiler": "Majd al-Din al-Fayruzabadi", "died": 1414, "tier": "general", "source": "OpenITI Shamela0007283-ara1 (Muassasat al-Risala)", "match_type": "root", "entries": [{"headword": "ثغثغ", "text": "ثغثغ كلامه: خلط فيه، وهو ثغثغ وثغثاغ الكلام. والثغثغة: عض الصبي قبل أن يثغر، والكلام لا نظام له، والتفتيش، وفعل المتكلم المضطرب المحرك أسنانه في فمه."}]}], "cap": null}
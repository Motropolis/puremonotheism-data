{"root": "y-a-t6-b", "root_ar": "ياطب", "quranic": false, "quran_frequency": null, "summary": null, "lane": null, "lane_match_type": null, "classical": [{"id": "qamus", "name": "al-Qamus al-Muhit", "name_ar": "القاموس المحيط", "compiler": "Majd al-Din al-Fayruzabadi", "died": 1414, "tier": "general", "source": "OpenITI Shamela0007283-ara1 (Muassasat al-Risala)", "match_type": "root", "entries": [{"headword": "ياطب", "text": "ياطب، كياسر: مياه في أجأ. وما أيطبه: ما أطيبه. وأقبلت الشاة (تهوي) في أيطبتها، وتشدد الباء، أي: شدة استحرامها."}]}], "cap": null}
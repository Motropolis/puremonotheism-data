{"id":60,"verses":[{"k":"60:1","ar":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَتَّخِذُواْ عَدُوِّي وَعَدُوَّكُمۡ أَوۡلِيَآءَ تُلۡقُونَ إِلَيۡهِم بِٱلۡمَوَدَّةِ وَقَدۡ كَفَرُواْ بِمَا جَآءَكُم مِّنَ ٱلۡحَقِّ يُخۡرِجُونَ ٱلرَّسُولَ وَإِيَّاكُمۡ أَن تُؤۡمِنُواْ بِٱللَّهِ رَبِّكُمۡ إِن كُنتُمۡ خَرَجۡتُمۡ جِهَٰدࣰ ا فِي سَبِيلِي وَٱبۡتِغَآءَ مَرۡضَاتِيۚ تُسِرُّونَ إِلَيۡهِم بِٱلۡمَوَدَّةِ وَأَنَا۠ أَعۡلَمُ بِمَآ أَخۡفَيۡتُمۡ وَمَآ أَعۡلَنتُمۡۚ وَمَن يَفۡعَلۡهُ مِنكُمۡ فَقَدۡ ضَلَّ سَوَآءَ ٱلسَّبِيلِ","s":"يايها الذين ءامنوا لا تتخذوا عدوي وعدوكم اولياء تلقون اليهم بالموده وقد كفروا بما جاءكم من الحق يخرجون الرسول واياكم ان تومنوا بالله ربكم ان كنتم خرجتم جهد ا في سبيلي وابتغاء مرضاتي تسرون اليهم بالموده وانا اعلم بما اخفيتم وما اعلنتم ومن يفعله منكم فقد ضل سواء السبيل","w":[{"i":1,"ar":"يَٰٓأَيُّهَا","r":"a-y-y","ra":"أيي","lem":"أَيّ","pos":"N","g":"noun accusative"},{"i":2,"ar":"ٱلَّذِينَ","lem":"الَّذِي","pos":"N","g":"masculine plural noun","nr":"Relative pronoun — no triliteral root","lk":"a-l-dh-y"},{"i":3,"ar":"ءَامَنُواْ","r":"a-m-n","ra":"أمن","lem":"آمَنَ","pos":"V","g":"form IV perfect verb (3rd person masculine plural)"},{"i":4,"ar":"لَا","lem":"لا","pos":"P","g":"particle","nr":"No triliteral root recorded","lk":"l-a"},{"i":5,"ar":"تَتَّخِذُواْ","r":"a-kh-dh","ra":"أخذ","lem":"اتَّخَذَ","pos":"V","g":"form VIII imperfect verb (2nd person masculine plural)"},{"i":6,"ar":"عَدُوِّي","r":"3-d-w","ra":"عدو","lem":"عَدُوّ","pos":"N","g":"masculine noun accusative"},{"i":7,"ar":"وَعَدُوَّكُمۡ","r":"3-d-w","ra":"عدو","lem":"عَدُوّ","pos":"N","g":"masculine noun accusative"},{"i":8,"ar":"أَوۡلِيَآءَ","r":"w-l-y","ra":"ولي","lem":"وَلِيّ","pos":"N","g":"masculine plural noun accusative"},{"i":9,"ar":"تُلۡقُونَ","r":"l-q-y","ra":"لقي","lem":"أَلْقَى","pos":"V","g":"form IV imperfect verb (2nd person masculine plural)"},{"i":10,"ar":"إِلَيۡهِم","lem":"إِلَى","pos":"P","g":"particle","nr":"Particle — no triliteral root","lk":"a-l-y5"},{"i":11,"ar":"بِٱ
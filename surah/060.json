{"id":60,"verses":[{"k":"60:1","ar":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَتَّخِذُواْ عَدُوِّي وَعَدُوَّكُمۡ أَوۡلِيَآءَ تُلۡقُونَ إِلَيۡهِم بِٱلۡمَوَدَّةِ وَقَدۡ كَفَرُواْ بِمَا جَآءَكُم مِّنَ ٱلۡحَقِّ يُخۡرِجُونَ ٱلرَّسُولَ وَإِيَّاكُمۡ أَن تُؤۡمِنُواْ بِٱللَّهِ رَبِّكُمۡ إِن كُنتُمۡ خَرَجۡتُمۡ جِهَٰدࣰ ا فِي سَبِيلِي وَٱبۡتِغَآءَ مَرۡضَاتِيۚ تُسِرُّونَ إِلَيۡهِم بِٱلۡمَوَدَّةِ وَأَنَا۠ أَعۡلَمُ بِمَآ أَخۡفَيۡتُمۡ وَمَآ أَعۡلَنتُمۡۚ وَمَن يَفۡعَلۡهُ مِنكُمۡ فَقَدۡ ضَلَّ سَوَآءَ ٱلسَّبِيلِ","s":"يايها الذين ءامنوا لا تتخذوا عدوي وعدوكم اولياء تلقون اليهم بالموده وقد كفروا بما جاءكم من الحق يخرجون الرسول واياكم ان تومنوا بالله ربكم ان كنتم خرجتم جهد ا في سبيلي وابتغاء مرضاتي تسرون اليهم بالموده وانا اعلم بما اخفيتم وما اعلنتم ومن يفعله منكم فقد ضل سواء السبيل","w":[{"i":1,"ar":"يَٰٓأَيُّهَا","r":"a-y-y","ra":"أيي","lem":"أَيّ","pos":"N"},{"i":2,"ar":"ٱلَّذِينَ","lem":"الَّذِي","pos":"N"},{"i":3,"ar":"ءَامَنُواْ","r":"a-m-n","ra":"أمن","lem":"آمَنَ","pos":"V"},{"i":4,"ar":"لَا","lem":"لا","pos":"P"},{"i":5,"ar":"تَتَّخِذُواْ","r":"a-kh-dh","ra":"أخذ","lem":"اتَّخَذَ","pos":"V"},{"i":6,"ar":"عَدُوِّي","r":"3-d-w","ra":"عدو","lem":"عَدُوّ","pos":"N"},{"i":7,"ar":"وَعَدُوَّكُمۡ","r":"3-d-w","ra":"عدو","lem":"عَدُوّ","pos":"N"},{"i":8,"ar":"أَوۡلِيَآءَ","r":"w-l-y","ra":"ولي","lem":"وَلِيّ","pos":"N"},{"i":9,"ar":"تُلۡقُونَ","r":"l-q-y","ra":"لقي","lem":"أَلْقَى","pos":"V"},{"i":10,"ar":"إِلَيۡهِم","lem":"إِلَى","pos":"P"},{"i":11,"ar":"بِٱلۡمَوَدَّةِ","r":"w-d-d","ra":"ودد","lem":"مَوَدَّة","pos":"N"},{"i":12,"ar":"وَقَدۡ","lem":"قَد","pos":"P"},{"i":13,"ar":"كَفَرُواْ","r":"k-f-r","ra":"كفر","lem":"كَفَرَ","pos":"V"},{"i":14,"ar":"بِمَا","lem":"ما","pos":"N"},{"i":15,"ar":"جَآءَكُم","r":"j-y-a","ra":"جيأ","lem":"جاءَ","pos":"V"},{"i":16,"ar":"مِّنَ","lem":"مِن","pos":"P"},{"i":17,"ar":"ٱلۡحَقِّ","r":"h7-q-q","ra":"حقق","lem":"حَقّ","pos":"N"},{"i":18,"ar":"يُخۡرِجُونَ","r":"kh-r-j","ra":"خرج","lem":"أَخْرَجَ","pos":"V"},{"i":19,"ar":"ٱلرَّسُولَ"
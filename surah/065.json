{"id":65,"verses":[{"k":"65:1","ar":"يَٰٓأَيُّهَا ٱلنَّبِيُّ إِذَا طَلَّقۡتُمُ ٱلنِّسَآءَ فَطَلِّقُوهُنَّ لِعِدَّتِهِنَّ وَأَحۡصُواْ ٱلۡعِدَّةَۖ وَٱتَّقُواْ ٱللَّهَ رَبَّكُمۡۖ لَا تُخۡرِجُوهُنَّ مِنۢ بُيُوتِهِنَّ وَلَا يَخۡرُجۡنَ إِلَّآ أَن يَأۡتِينَ بِفَٰحِشَةࣲ مُّبَيِّنَةࣲۚ وَتِلۡكَ حُدُودُ ٱللَّهِۚ وَمَن يَتَعَدَّ حُدُودَ ٱللَّهِ فَقَدۡ ظَلَمَ نَفۡسَهُۥۚ لَا تَدۡرِي لَعَلَّ ٱللَّهَ يُحۡدِثُ بَعۡدَ ذَٰلِكَ أَمۡرࣰ ا","s":"يايها النبي اذا طلقتم النساء فطلقوهن لعدتهن واحصوا العده واتقوا الله ربكم لا تخرجوهن من بيوتهن ولا يخرجن الا ان ياتين بفحشه مبينه وتلك حدود الله ومن يتعد حدود الله فقد ظلم نفسه لا تدري لعل الله يحدث بعد ذلك امر ا","w":[{"i":1,"ar":"يَٰٓأَيُّهَا","r":"a-y-y","ra":"أيي","lem":"أَيّ","pos":"N","g":"noun accusative"},{"i":2,"ar":"ٱلنَّبِيُّ","r":"n-b-a","ra":"نبأ","lem":"نَبِيّ","pos":"N","g":"masculine noun nominative"},{"i":3,"ar":"إِذَا","lem":"إِذا","pos":"N","g":"noun","nr":"Time adverb — no triliteral root","lk":"a-dh-a"},{"i":4,"ar":"طَلَّقۡتُمُ","r":"t6-l-q","ra":"طلق","lem":"طَلَّقَ","pos":"V","g":"form II perfect verb (2nd person masculine plural)"},{"i":5,"ar":"ٱلنِّسَآءَ","r":"n-s-w","ra":"نسو","lem":"نِساء","pos":"N","g":"feminine plural noun accusative"},{"i":6,"ar":"فَطَلِّقُوهُنَّ","r":"t6-l-q","ra":"طلق","lem":"طَلَّقَ","pos":"V","g":"form II imperative verb (2nd person masculine plural)"},{"i":7,"ar":"لِعِدَّتِهِنَّ","r":"3-d-d","ra":"عدد","lem":"عِدَّة","pos":"N","g":"feminine noun genitive"},{"i":8,"ar":"وَأَحۡصُواْ","r":"h7-s6-y","ra":"حصي","lem":"أَحْصَى","pos":"V","g":"form IV imperative verb (2nd person masculine plural)"},{"i":9,"ar":"ٱلۡعِدَّةَۖ","r":"3-d-d","ra":"عدد","lem":"عِدَّة","pos":"N","g":"feminine noun accusative"},{"i":10,"ar":"وَٱتَّقُواْ","r":"w-q-y","ra":"وقي","lem":"اتَّقَى","pos":"V","g":"form VIII imperative verb (2nd person masculine plural)"},{"i":11,"ar":"ٱللَّهَ","r":"a-l-h","ra":"أله","lem":"اللَّه","pos":"N","g":"proper noun accusative"},{"i":12,"ar":"رَبَّكُمۡۖ","r":"r-b-b","ra":"ربب","lem
{"id":82,"verses":[{"k":"82:1","ar":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ","s":"اذا السماء انفطرت","w":[{"i":1,"ar":"إِذَا"},{"i":2,"ar":"ٱلسَّمَآءُ"},{"i":3,"ar":"ٱنفَطَرَتۡ"}]},{"k":"82:2","ar":"وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ","s":"واذا الكواكب انتثرت","w":[{"i":1,"ar":"وَإِذَا"},{"i":2,"ar":"ٱلۡكَوَاكِبُ"},{"i":3,"ar":"ٱنتَثَرَتۡ"}]},{"k":"82:3","ar":"وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ","s":"واذا البحار فجرت","w":[{"i":1,"ar":"وَإِذَا"},{"i":2,"ar":"ٱلۡبِحَارُ"},{"i":3,"ar":"فُجِّرَتۡ"}]},{"k":"82:4","ar":"وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ","s":"واذا القبور بعثرت","w":[{"i":1,"ar":"وَإِذَا"},{"i":2,"ar":"ٱلۡقُبُورُ"},{"i":3,"ar":"بُعۡثِرَتۡ"}]},{"k":"82:5","ar":"عَلِمَتۡ نَفۡسࣱ مَّا قَدَّمَتۡ وَأَخَّرَتۡ","s":"علمت نفس ما قدمت واخرت","w":[{"i":1,"ar":"عَلِمَتۡ"},{"i":2,"ar":"نَفۡسࣱ"},{"i":3,"ar":"مَّا"},{"i":4,"ar":"قَدَّمَتۡ"},{"i":5,"ar":"وَأَخَّرَتۡ"}]},{"k":"82:6","ar":"يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ","s":"يايها الانسن ما غرك بربك الكريم","w":[{"i":1,"ar":"يَٰٓأَيُّهَا"},{"i":2,"ar":"ٱلۡإِنسَٰنُ"},{"i":3,"ar":"مَا"},{"i":4,"ar":"غَرَّكَ"},{"i":5,"ar":"بِرَبِّكَ"},{"i":6,"ar":"ٱلۡكَرِيمِ"}]},{"k":"82:7","ar":"ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","s":"الذي خلقك فسويك فعدلك","w":[{"i":1,"ar":"ٱلَّذِي"},{"i":2,"ar":"خَلَقَكَ"},{"i":3,"ar":"فَسَوَّىٰكَ"},{"i":4,"ar":"فَعَدَلَكَ"}]},{"k":"82:8","ar":"فِيٓ أَيِّ صُورَةࣲ مَّا شَآءَ رَكَّبَكَ","s":"في اي صوره ما شاء ركبك","w":[{"i":1,"ar":"فِيٓ"},{"i":2,"ar":"أَيِّ"},{"i":3,"ar":"صُورَةࣲ"},{"i":4,"ar":"مَّا"},{"i":5,"ar":"شَآءَ"},{"i":6,"ar":"رَكَّبَكَ"}]},{"k":"82:9","ar":"كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ","s":"كلا بل تكذبون بالدين","w":[{"i":1,"ar":"كَلَّا"},{"i":2,"ar":"بَلۡ"},{"i":3,"ar":"تُكَذِّبُونَ"},{"i":4,"ar":"بِٱلدِّينِ"}]},{"k":"82:10","ar":"وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ","s":"وان عليكم لحفظين","w":[{"i":1,"ar":"وَإِنَّ"},{"i":2,"ar":"عَلَيۡكُمۡ"},{"i":3,"ar":"لَحَٰفِظِينَ"}]},{"k":"82:11","ar":"كِرَامࣰ ا كَٰتِبِينَ","s":"كرام ا كتبين","w":[{"i":1,"ar":"كِرَامࣰ"},{"i
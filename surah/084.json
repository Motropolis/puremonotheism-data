{"id":84,"verses":[{"k":"84:1","ar":"إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ","s":"اذا السماء انشقت","w":[{"i":1,"ar":"إِذَا"},{"i":2,"ar":"ٱلسَّمَآءُ"},{"i":3,"ar":"ٱنشَقَّتۡ"}]},{"k":"84:2","ar":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ","s":"واذنت لربها وحقت","w":[{"i":1,"ar":"وَأَذِنَتۡ"},{"i":2,"ar":"لِرَبِّهَا"},{"i":3,"ar":"وَحُقَّتۡ"}]},{"k":"84:3","ar":"وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ","s":"واذا الارض مدت","w":[{"i":1,"ar":"وَإِذَا"},{"i":2,"ar":"ٱلۡأَرۡضُ"},{"i":3,"ar":"مُدَّتۡ"}]},{"k":"84:4","ar":"وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ","s":"والقت ما فيها وتخلت","w":[{"i":1,"ar":"وَأَلۡقَتۡ"},{"i":2,"ar":"مَا"},{"i":3,"ar":"فِيهَا"},{"i":4,"ar":"وَتَخَلَّتۡ"}]},{"k":"84:5","ar":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ","s":"واذنت لربها وحقت","w":[{"i":1,"ar":"وَأَذِنَتۡ"},{"i":2,"ar":"لِرَبِّهَا"},{"i":3,"ar":"وَحُقَّتۡ"}]},{"k":"84:6","ar":"يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحࣰ ا فَمُلَٰقِيهِ","s":"يايها الانسن انك كادح الي ربك كدح ا فملقيه","w":[{"i":1,"ar":"يَٰٓأَيُّهَا"},{"i":2,"ar":"ٱلۡإِنسَٰنُ"},{"i":3,"ar":"إِنَّكَ"},{"i":4,"ar":"كَادِحٌ"},{"i":5,"ar":"إِلَىٰ"},{"i":6,"ar":"رَبِّكَ"},{"i":7,"ar":"كَدۡحࣰ"},{"i":8,"ar":"ا"},{"i":9,"ar":"فَمُلَٰقِيهِ"}]},{"k":"84:7","ar":"فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ","s":"فاما من اوتي كتبه بيمينه","w":[{"i":1,"ar":"فَأَمَّا"},{"i":2,"ar":"مَنۡ"},{"i":3,"ar":"أُوتِيَ"},{"i":4,"ar":"كِتَٰبَهُۥ"},{"i":5,"ar":"بِيَمِينِهِۦ"}]},{"k":"84:8","ar":"فَسَوۡفَ يُحَاسَبُ حِسَابࣰ ا يَسِيرࣰ ا","s":"فسوف يحاسب حساب ا يسير ا","w":[{"i":1,"ar":"فَسَوۡفَ"},{"i":2,"ar":"يُحَاسَبُ"},{"i":3,"ar":"حِسَابࣰ"},{"i":4,"ar":"ا"},{"i":5,"ar":"يَسِيرࣰ"},{"i":6,"ar":"ا"}]},{"k":"84:9","ar":"وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورࣰ ا","s":"وينقلب الي اهله مسرور ا","w":[{"i":1,"ar":"وَيَنقَلِبُ"},{"i":2,"ar":"إِلَىٰٓ"},{"i":3,"ar":"أَهۡلِهِۦ"},{"i":4,"ar":"مَسۡرُورࣰ"},{"i":5,"ar":"ا"}]},{"k":"84:10","ar":"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ","s":"واما من اوتي كتبه وراء ظهره","w":[{"i":1,"ar":"وَأَمَ
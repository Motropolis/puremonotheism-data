{"id":85,"verses":[{"k":"85:1","ar":"وَٱلسَّمَآءِ ذَاتِ ٱلۡبُرُوجِ","s":"والسماء ذات البروج","w":[{"i":1,"ar":"وَٱلسَّمَآءِ"},{"i":2,"ar":"ذَاتِ"},{"i":3,"ar":"ٱلۡبُرُوجِ"}]},{"k":"85:2","ar":"وَٱلۡيَوۡمِ ٱلۡمَوۡعُودِ","s":"واليوم الموعود","w":[{"i":1,"ar":"وَٱلۡيَوۡمِ"},{"i":2,"ar":"ٱلۡمَوۡعُودِ"}]},{"k":"85:3","ar":"وَشَاهِدࣲ وَمَشۡهُودࣲ‏","s":"وشاهد ومشهود‏","w":[{"i":1,"ar":"وَشَاهِدࣲ"},{"i":2,"ar":"وَمَشۡهُودࣲ‏"}]},{"k":"85:4","ar":"قُتِلَ أَصۡحَٰبُ ٱلۡأُخۡدُودِ","s":"قتل اصحب الاخدود","w":[{"i":1,"ar":"قُتِلَ"},{"i":2,"ar":"أَصۡحَٰبُ"},{"i":3,"ar":"ٱلۡأُخۡدُودِ"}]},{"k":"85:5","ar":"ٱلنَّارِ ذَاتِ ٱلۡوَقُودِ","s":"النار ذات الوقود","w":[{"i":1,"ar":"ٱلنَّارِ"},{"i":2,"ar":"ذَاتِ"},{"i":3,"ar":"ٱلۡوَقُودِ"}]},{"k":"85:6","ar":"إِذۡ هُمۡ عَلَيۡهَا قُعُودࣱ‏","s":"اذ هم عليها قعود‏","w":[{"i":1,"ar":"إِذۡ"},{"i":2,"ar":"هُمۡ"},{"i":3,"ar":"عَلَيۡهَا"},{"i":4,"ar":"قُعُودࣱ‏"}]},{"k":"85:7","ar":"وَهُمۡ عَلَىٰ مَا يَفۡعَلُونَ بِٱلۡمُؤۡمِنِينَ شُهُودࣱ‏","s":"وهم علي ما يفعلون بالمومنين شهود‏","w":[{"i":1,"ar":"وَهُمۡ"},{"i":2,"ar":"عَلَىٰ"},{"i":3,"ar":"مَا"},{"i":4,"ar":"يَفۡعَلُونَ"},{"i":5,"ar":"بِٱلۡمُؤۡمِنِينَ"},{"i":6,"ar":"شُهُودࣱ‏"}]},{"k":"85:8","ar":"وَمَا نَقَمُواْ مِنۡهُمۡ إِلَّآ أَن يُؤۡمِنُواْ بِٱللَّهِ ٱلۡعَزِيزِ ٱلۡحَمِيدِ","s":"وما نقموا منهم الا ان يومنوا بالله العزيز الحميد","w":[{"i":1,"ar":"وَمَا"},{"i":2,"ar":"نَقَمُواْ"},{"i":3,"ar":"مِنۡهُمۡ"},{"i":4,"ar":"إِلَّآ"},{"i":5,"ar":"أَن"},{"i":6,"ar":"يُؤۡمِنُواْ"},{"i":7,"ar":"بِٱللَّهِ"},{"i":8,"ar":"ٱلۡعَزِيزِ"},{"i":9,"ar":"ٱلۡحَمِيدِ"}]},{"k":"85:9","ar":"ٱلَّذِي لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءࣲ شَهِيدٌ","s":"الذي له ملك السموت والارض والله علي كل شيء شهيد","w":[{"i":1,"ar":"ٱلَّذِي"},{"i":2,"ar":"لَهُۥ"},{"i":3,"ar":"مُلۡكُ"},{"i":4,"ar":"ٱلسَّمَٰوَٰتِ"},{"i":5,"ar":"وَٱلۡأَرۡضِۚ"},{"i":6,"ar":"وَٱللَّهُ"},{"i":7,"ar":"عَلَىٰ"},{"i":8,"ar":"كُلِّ"},{"i":9,"ar":"شَيۡءࣲ"},{"i":10,"ar":"شَهِيدٌ"}]},{"k":"85:10","ar":"إِنَّ ٱلَّذِينَ فَتَن
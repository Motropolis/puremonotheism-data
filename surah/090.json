{"id":90,"verses":[{"k":"90:1","ar":"لَآ أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ","s":"لا اقسم بهذا البلد","w":[{"i":1,"ar":"لَآ"},{"i":2,"ar":"أُقۡسِمُ"},{"i":3,"ar":"بِهَٰذَا"},{"i":4,"ar":"ٱلۡبَلَدِ"}]},{"k":"90:2","ar":"وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ","s":"وانت حل بهذا البلد","w":[{"i":1,"ar":"وَأَنتَ"},{"i":2,"ar":"حِلُّۢ"},{"i":3,"ar":"بِهَٰذَا"},{"i":4,"ar":"ٱلۡبَلَدِ"}]},{"k":"90:3","ar":"وَوَالِدࣲ وَمَا وَلَدَ","s":"ووالد وما ولد","w":[{"i":1,"ar":"وَوَالِدࣲ"},{"i":2,"ar":"وَمَا"},{"i":3,"ar":"وَلَدَ"}]},{"k":"90:4","ar":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ","s":"لقد خلقنا الانسن في كبد","w":[{"i":1,"ar":"لَقَدۡ"},{"i":2,"ar":"خَلَقۡنَا"},{"i":3,"ar":"ٱلۡإِنسَٰنَ"},{"i":4,"ar":"فِي"},{"i":5,"ar":"كَبَدٍ"}]},{"k":"90:5","ar":"أَيَحۡسَبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدࣱ‏","s":"ايحسب ان لن يقدر عليه احد‏","w":[{"i":1,"ar":"أَيَحۡسَبُ"},{"i":2,"ar":"أَن"},{"i":3,"ar":"لَّن"},{"i":4,"ar":"يَقۡدِرَ"},{"i":5,"ar":"عَلَيۡهِ"},{"i":6,"ar":"أَحَدࣱ‏"}]},{"k":"90:6","ar":"يَقُولُ أَهۡلَكۡتُ مَالࣰ ا لُّبَدًا","s":"يقول اهلكت مال ا لبدا","w":[{"i":1,"ar":"يَقُولُ"},{"i":2,"ar":"أَهۡلَكۡتُ"},{"i":3,"ar":"مَالࣰ"},{"i":4,"ar":"ا"},{"i":5,"ar":"لُّبَدًا"}]},{"k":"90:7","ar":"أَيَحۡسَبُ أَن لَّمۡ يَرَهُۥٓ أَحَدٌ","s":"ايحسب ان لم يره احد","w":[{"i":1,"ar":"أَيَحۡسَبُ"},{"i":2,"ar":"أَن"},{"i":3,"ar":"لَّمۡ"},{"i":4,"ar":"يَرَهُۥٓ"},{"i":5,"ar":"أَحَدٌ"}]},{"k":"90:8","ar":"أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ","s":"الم نجعل له عينين","w":[{"i":1,"ar":"أَلَمۡ"},{"i":2,"ar":"نَجۡعَل"},{"i":3,"ar":"لَّهُۥ"},{"i":4,"ar":"عَيۡنَيۡنِ"}]},{"k":"90:9","ar":"وَلِسَانࣰ ا وَشَفَتَيۡنِ","s":"ولسان ا وشفتين","w":[{"i":1,"ar":"وَلِسَانࣰ"},{"i":2,"ar":"ا"},{"i":3,"ar":"وَشَفَتَيۡنِ"}]},{"k":"90:10","ar":"وَهَدَيۡنَٰهُ ٱلنَّجۡدَيۡنِ","s":"وهدينه النجدين","w":[{"i":1,"ar":"وَهَدَيۡنَٰهُ"},{"i":2,"ar":"ٱلنَّجۡدَيۡنِ"}]},{"k":"90:11","ar":"فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ","s":"فلا اقتحم العقبه","w":[{"i":1,"ar":"فَلَا"},{"i":2,"ar":"ٱقۡتَحَمَ"},{"i":3,"ar":"ٱلۡعَقَبَةَ"}]},{"k":"90:
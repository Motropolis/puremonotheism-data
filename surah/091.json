{"id":91,"verses":[{"k":"91:1","ar":"وَٱلشَّمۡسِ وَضُحَىٰهَا","s":"والشمس وضحيها","w":[{"i":1,"ar":"وَٱلشَّمۡسِ"},{"i":2,"ar":"وَضُحَىٰهَا"}]},{"k":"91:2","ar":"وَٱلۡقَمَرِ إِذَا تَلَىٰهَا","s":"والقمر اذا تليها","w":[{"i":1,"ar":"وَٱلۡقَمَرِ"},{"i":2,"ar":"إِذَا"},{"i":3,"ar":"تَلَىٰهَا"}]},{"k":"91:3","ar":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","s":"والنهار اذا جليها","w":[{"i":1,"ar":"وَٱلنَّهَارِ"},{"i":2,"ar":"إِذَا"},{"i":3,"ar":"جَلَّىٰهَا"}]},{"k":"91:4","ar":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰهَا","s":"واليل اذا يغشيها","w":[{"i":1,"ar":"وَٱلَّيۡلِ"},{"i":2,"ar":"إِذَا"},{"i":3,"ar":"يَغۡشَىٰهَا"}]},{"k":"91:5","ar":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","s":"والسماء وما بنيها","w":[{"i":1,"ar":"وَٱلسَّمَآءِ"},{"i":2,"ar":"وَمَا"},{"i":3,"ar":"بَنَىٰهَا"}]},{"k":"91:6","ar":"وَٱلۡأَرۡضِ وَمَا طَحَىٰهَا","s":"والارض وما طحيها","w":[{"i":1,"ar":"وَٱلۡأَرۡضِ"},{"i":2,"ar":"وَمَا"},{"i":3,"ar":"طَحَىٰهَا"}]},{"k":"91:7","ar":"وَنَفۡسࣲ وَمَا سَوَّىٰهَا","s":"ونفس وما سويها","w":[{"i":1,"ar":"وَنَفۡسࣲ"},{"i":2,"ar":"وَمَا"},{"i":3,"ar":"سَوَّىٰهَا"}]},{"k":"91:8","ar":"فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىٰهَا","s":"فالهمها فجورها وتقويها","w":[{"i":1,"ar":"فَأَلۡهَمَهَا"},{"i":2,"ar":"فُجُورَهَا"},{"i":3,"ar":"وَتَقۡوَىٰهَا"}]},{"k":"91:9","ar":"قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا","s":"قد افلح من زكيها","w":[{"i":1,"ar":"قَدۡ"},{"i":2,"ar":"أَفۡلَحَ"},{"i":3,"ar":"مَن"},{"i":4,"ar":"زَكَّىٰهَا"}]},{"k":"91:10","ar":"وَقَدۡ خَابَ مَن دَسَّىٰهَا","s":"وقد خاب من دسيها","w":[{"i":1,"ar":"وَقَدۡ"},{"i":2,"ar":"خَابَ"},{"i":3,"ar":"مَن"},{"i":4,"ar":"دَسَّىٰهَا"}]},{"k":"91:11","ar":"كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَآ","s":"كذبت ثمود بطغويها","w":[{"i":1,"ar":"كَذَّبَتۡ"},{"i":2,"ar":"ثَمُودُ"},{"i":3,"ar":"بِطَغۡوَىٰهَآ"}]},{"k":"91:12","ar":"إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا","s":"اذ انبعث اشقيها","w":[{"i":1,"ar":"إِذِ"},{"i":2,"ar":"ٱنۢبَعَثَ"},{"i":3,"ar":"أَشۡقَىٰهَا"}]},{"k":"91:13","ar":"فَقَالَ لَهُمۡ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡيَٰهَا","s":"فقال لهم رسول الله ناقه الله 
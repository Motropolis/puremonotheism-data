{"id":92,"verses":[{"k":"92:1","ar":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰ","s":"واليل اذا يغشي","w":[{"i":1,"ar":"وَٱلَّيۡلِ"},{"i":2,"ar":"إِذَا"},{"i":3,"ar":"يَغۡشَىٰ"}]},{"k":"92:2","ar":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","s":"والنهار اذا تجلي","w":[{"i":1,"ar":"وَٱلنَّهَارِ"},{"i":2,"ar":"إِذَا"},{"i":3,"ar":"تَجَلَّىٰ"}]},{"k":"92:3","ar":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ","s":"وما خلق الذكر والانثي","w":[{"i":1,"ar":"وَمَا"},{"i":2,"ar":"خَلَقَ"},{"i":3,"ar":"ٱلذَّكَرَ"},{"i":4,"ar":"وَٱلۡأُنثَىٰٓ"}]},{"k":"92:4","ar":"إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ","s":"ان سعيكم لشتي","w":[{"i":1,"ar":"إِنَّ"},{"i":2,"ar":"سَعۡيَكُمۡ"},{"i":3,"ar":"لَشَتَّىٰ"}]},{"k":"92:5","ar":"فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ","s":"فاما من اعطي واتقي","w":[{"i":1,"ar":"فَأَمَّا"},{"i":2,"ar":"مَنۡ"},{"i":3,"ar":"أَعۡطَىٰ"},{"i":4,"ar":"وَٱتَّقَىٰ"}]},{"k":"92:6","ar":"وَصَدَّقَ بِٱلۡحُسۡنَىٰ","s":"وصدق بالحسني","w":[{"i":1,"ar":"وَصَدَّقَ"},{"i":2,"ar":"بِٱلۡحُسۡنَىٰ"}]},{"k":"92:7","ar":"فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ","s":"فسنيسره لليسري","w":[{"i":1,"ar":"فَسَنُيَسِّرُهُۥ"},{"i":2,"ar":"لِلۡيُسۡرَىٰ"}]},{"k":"92:8","ar":"وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ","s":"واما من بخل واستغني","w":[{"i":1,"ar":"وَأَمَّا"},{"i":2,"ar":"مَنۢ"},{"i":3,"ar":"بَخِلَ"},{"i":4,"ar":"وَٱسۡتَغۡنَىٰ"}]},{"k":"92:9","ar":"وَكَذَّبَ بِٱلۡحُسۡنَىٰ","s":"وكذب بالحسني","w":[{"i":1,"ar":"وَكَذَّبَ"},{"i":2,"ar":"بِٱلۡحُسۡنَىٰ"}]},{"k":"92:10","ar":"فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ","s":"فسنيسره للعسري","w":[{"i":1,"ar":"فَسَنُيَسِّرُهُۥ"},{"i":2,"ar":"لِلۡعُسۡرَىٰ"}]},{"k":"92:11","ar":"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","s":"وما يغني عنه ماله اذا تردي","w":[{"i":1,"ar":"وَمَا"},{"i":2,"ar":"يُغۡنِي"},{"i":3,"ar":"عَنۡهُ"},{"i":4,"ar":"مَالُهُۥٓ"},{"i":5,"ar":"إِذَا"},{"i":6,"ar":"تَرَدَّىٰٓ"}]},{"k":"92:12","ar":"إِنَّ عَلَيۡنَا لَلۡهُدَىٰ","s":"ان علينا للهدي","w":[{"i":1,"ar":"إِنَّ"},{"i":2,"ar":"عَلَيۡنَا"},{"i":3,"ar":"لَلۡهُدَىٰ"}]},{"k":"92:13","ar":"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَ
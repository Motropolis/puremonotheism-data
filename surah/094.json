{"id":94,"verses":[{"k":"94:1","ar":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ","s":"الم نشرح لك صدرك","w":[{"i":1,"ar":"أَلَمۡ"},{"i":2,"ar":"نَشۡرَحۡ"},{"i":3,"ar":"لَكَ"},{"i":4,"ar":"صَدۡرَكَ"}]},{"k":"94:2","ar":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ","s":"ووضعنا عنك وزرك","w":[{"i":1,"ar":"وَوَضَعۡنَا"},{"i":2,"ar":"عَنكَ"},{"i":3,"ar":"وِزۡرَكَ"}]},{"k":"94:3","ar":"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ","s":"الذي انقض ظهرك","w":[{"i":1,"ar":"ٱلَّذِيٓ"},{"i":2,"ar":"أَنقَضَ"},{"i":3,"ar":"ظَهۡرَكَ"}]},{"k":"94:4","ar":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ","s":"ورفعنا لك ذكرك","w":[{"i":1,"ar":"وَرَفَعۡنَا"},{"i":2,"ar":"لَكَ"},{"i":3,"ar":"ذِكۡرَكَ"}]},{"k":"94:5","ar":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا","s":"فان مع العسر يسرا","w":[{"i":1,"ar":"فَإِنَّ"},{"i":2,"ar":"مَعَ"},{"i":3,"ar":"ٱلۡعُسۡرِ"},{"i":4,"ar":"يُسۡرًا"}]},{"k":"94:6","ar":"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرࣰ ا","s":"ان مع العسر يسر ا","w":[{"i":1,"ar":"إِنَّ"},{"i":2,"ar":"مَعَ"},{"i":3,"ar":"ٱلۡعُسۡرِ"},{"i":4,"ar":"يُسۡرࣰ"},{"i":5,"ar":"ا"}]},{"k":"94:7","ar":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ","s":"فاذا فرغت فانصب","w":[{"i":1,"ar":"فَإِذَا"},{"i":2,"ar":"فَرَغۡتَ"},{"i":3,"ar":"فَٱنصَبۡ"}]},{"k":"94:8","ar":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب","s":"والي ربك فارغب","w":[{"i":1,"ar":"وَإِلَىٰ"},{"i":2,"ar":"رَبِّكَ"},{"i":3,"ar":"فَٱرۡغَب"}]}]}
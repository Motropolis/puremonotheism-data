{"id":95,"verses":[{"k":"95:1","ar":"وَٱلتِّينِ وَٱلزَّيۡتُونِ","s":"والتين والزيتون","w":[{"i":1,"ar":"وَٱلتِّينِ"},{"i":2,"ar":"وَٱلزَّيۡتُونِ"}]},{"k":"95:2","ar":"وَطُورِ سِينِينَ","s":"وطور سينين","w":[{"i":1,"ar":"وَطُورِ"},{"i":2,"ar":"سِينِينَ"}]},{"k":"95:3","ar":"وَهَٰذَا ٱلۡبَلَدِ ٱلۡأَمِينِ","s":"وهذا البلد الامين","w":[{"i":1,"ar":"وَهَٰذَا"},{"i":2,"ar":"ٱلۡبَلَدِ"},{"i":3,"ar":"ٱلۡأَمِينِ"}]},{"k":"95:4","ar":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِيٓ أَحۡسَنِ تَقۡوِيمࣲ‏","s":"لقد خلقنا الانسن في احسن تقويم‏","w":[{"i":1,"ar":"لَقَدۡ"},{"i":2,"ar":"خَلَقۡنَا"},{"i":3,"ar":"ٱلۡإِنسَٰنَ"},{"i":4,"ar":"فِيٓ"},{"i":5,"ar":"أَحۡسَنِ"},{"i":6,"ar":"تَقۡوِيمࣲ‏"}]},{"k":"95:5","ar":"ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ","s":"ثم رددنه اسفل سفلين","w":[{"i":1,"ar":"ثُمَّ"},{"i":2,"ar":"رَدَدۡنَٰهُ"},{"i":3,"ar":"أَسۡفَلَ"},{"i":4,"ar":"سَٰفِلِينَ"}]},{"k":"95:6","ar":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونࣲ‏","s":"الا الذين ءامنوا وعملوا الصلحت فلهم اجر غير ممنون‏","w":[{"i":1,"ar":"إِلَّا"},{"i":2,"ar":"ٱلَّذِينَ"},{"i":3,"ar":"ءَامَنُواْ"},{"i":4,"ar":"وَعَمِلُواْ"},{"i":5,"ar":"ٱلصَّٰلِحَٰتِ"},{"i":6,"ar":"فَلَهُمۡ"},{"i":7,"ar":"أَجۡرٌ"},{"i":8,"ar":"غَيۡرُ"},{"i":9,"ar":"مَمۡنُونࣲ‏"}]},{"k":"95:7","ar":"فَمَا يُكَذِّبُكَ بَعۡدُ بِٱلدِّينِ","s":"فما يكذبك بعد بالدين","w":[{"i":1,"ar":"فَمَا"},{"i":2,"ar":"يُكَذِّبُكَ"},{"i":3,"ar":"بَعۡدُ"},{"i":4,"ar":"بِٱلدِّينِ"}]},{"k":"95:8","ar":"أَلَيۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَٰكِمِينَ","s":"اليس الله باحكم الحكمين","w":[{"i":1,"ar":"أَلَيۡسَ"},{"i":2,"ar":"ٱللَّهُ"},{"i":3,"ar":"بِأَحۡكَمِ"},{"i":4,"ar":"ٱلۡحَٰكِمِينَ"}]}]}
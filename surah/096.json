{"id":96,"verses":[{"k":"96:1","ar":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ","s":"اقرا باسم ربك الذي خلق","w":[{"i":1,"ar":"ٱقۡرَأۡ"},{"i":2,"ar":"بِٱسۡمِ"},{"i":3,"ar":"رَبِّكَ"},{"i":4,"ar":"ٱلَّذِي"},{"i":5,"ar":"خَلَقَ"}]},{"k":"96:2","ar":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ","s":"خلق الانسن من علق","w":[{"i":1,"ar":"خَلَقَ"},{"i":2,"ar":"ٱلۡإِنسَٰنَ"},{"i":3,"ar":"مِنۡ"},{"i":4,"ar":"عَلَقٍ"}]},{"k":"96:3","ar":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ","s":"اقرا وربك الاكرم","w":[{"i":1,"ar":"ٱقۡرَأۡ"},{"i":2,"ar":"وَرَبُّكَ"},{"i":3,"ar":"ٱلۡأَكۡرَمُ"}]},{"k":"96:4","ar":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ","s":"الذي علم بالقلم","w":[{"i":1,"ar":"ٱلَّذِي"},{"i":2,"ar":"عَلَّمَ"},{"i":3,"ar":"بِٱلۡقَلَمِ"}]},{"k":"96:5","ar":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ","s":"علم الانسن ما لم يعلم","w":[{"i":1,"ar":"عَلَّمَ"},{"i":2,"ar":"ٱلۡإِنسَٰنَ"},{"i":3,"ar":"مَا"},{"i":4,"ar":"لَمۡ"},{"i":5,"ar":"يَعۡلَمۡ"}]},{"k":"96:6","ar":"كَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ","s":"كلا ان الانسن ليطغي","w":[{"i":1,"ar":"كَلَّآ"},{"i":2,"ar":"إِنَّ"},{"i":3,"ar":"ٱلۡإِنسَٰنَ"},{"i":4,"ar":"لَيَطۡغَىٰٓ"}]},{"k":"96:7","ar":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ","s":"ان رءاه استغني","w":[{"i":1,"ar":"أَن"},{"i":2,"ar":"رَّءَاهُ"},{"i":3,"ar":"ٱسۡتَغۡنَىٰٓ"}]},{"k":"96:8","ar":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ","s":"ان الي ربك الرجعي","w":[{"i":1,"ar":"إِنَّ"},{"i":2,"ar":"إِلَىٰ"},{"i":3,"ar":"رَبِّكَ"},{"i":4,"ar":"ٱلرُّجۡعَىٰٓ"}]},{"k":"96:9","ar":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ","s":"ارءيت الذي ينهي","w":[{"i":1,"ar":"أَرَءَيۡتَ"},{"i":2,"ar":"ٱلَّذِي"},{"i":3,"ar":"يَنۡهَىٰ"}]},{"k":"96:10","ar":"عَبۡدًا إِذَا صَلَّىٰٓ","s":"عبدا اذا صلي","w":[{"i":1,"ar":"عَبۡدًا"},{"i":2,"ar":"إِذَا"},{"i":3,"ar":"صَلَّىٰٓ"}]},{"k":"96:11","ar":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ","s":"ارءيت ان كان علي الهدي","w":[{"i":1,"ar":"أَرَءَيۡتَ"},{"i":2,"ar":"إِن"},{"i":3,"ar":"كَانَ"},{"i":4,"ar":"عَلَى"},{"i":5,"ar":"ٱلۡهُدَىٰٓ"}]},{"k":"96:12","ar":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ","s":"او امر ب
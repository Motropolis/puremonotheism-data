{"id":97,"verses":[{"k":"97:1","ar":"ٱلرَّحِيمِإِنَّآ أَنزَلۡنَٰهُ فِي لَيۡلَةِ ٱلۡقَدۡرِ","s":"الرحيمانا انزلنه في ليله القدر","w":[{"i":1,"ar":"ٱلرَّحِيمِإِنَّآ"},{"i":2,"ar":"أَنزَلۡنَٰهُ"},{"i":3,"ar":"فِي"},{"i":4,"ar":"لَيۡلَةِ"},{"i":5,"ar":"ٱلۡقَدۡرِ"}]},{"k":"97:2","ar":"وَمَآ أَدۡرَىٰكَ مَا لَيۡلَةُ ٱلۡقَدۡرِ","s":"وما ادريك ما ليله القدر","w":[{"i":1,"ar":"وَمَآ"},{"i":2,"ar":"أَدۡرَىٰكَ"},{"i":3,"ar":"مَا"},{"i":4,"ar":"لَيۡلَةُ"},{"i":5,"ar":"ٱلۡقَدۡرِ"}]},{"k":"97:3","ar":"لَيۡلَةُ ٱلۡقَدۡرِ خَيۡرࣱ مِّنۡ أَلۡفِ شَهۡرࣲ‏","s":"ليله القدر خير من الف شهر‏","w":[{"i":1,"ar":"لَيۡلَةُ"},{"i":2,"ar":"ٱلۡقَدۡرِ"},{"i":3,"ar":"خَيۡرࣱ"},{"i":4,"ar":"مِّنۡ"},{"i":5,"ar":"أَلۡفِ"},{"i":6,"ar":"شَهۡرࣲ‏"}]},{"k":"97:4","ar":"تَنَزَّلُ ٱلۡمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذۡنِ رَبِّهِم مِّن كُلِّ أَمۡرࣲ‏","s":"تنزل المليكه والروح فيها باذن ربهم من كل امر‏","w":[{"i":1,"ar":"تَنَزَّلُ"},{"i":2,"ar":"ٱلۡمَلَٰٓئِكَةُ"},{"i":3,"ar":"وَٱلرُّوحُ"},{"i":4,"ar":"فِيهَا"},{"i":5,"ar":"بِإِذۡنِ"},{"i":6,"ar":"رَبِّهِم"},{"i":7,"ar":"مِّن"},{"i":8,"ar":"كُلِّ"},{"i":9,"ar":"أَمۡرࣲ‏"}]},{"k":"97:5","ar":"سَلَٰمٌ هِيَ حَتَّىٰ مَطۡلَعِ ٱلۡفَجۡرِ","s":"سلم هي حتي مطلع الفجر","w":[{"i":1,"ar":"سَلَٰمٌ"},{"i":2,"ar":"هِيَ"},{"i":3,"ar":"حَتَّىٰ"},{"i":4,"ar":"مَطۡلَعِ"},{"i":5,"ar":"ٱلۡفَجۡرِ"}]}]}
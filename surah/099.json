{"id":99,"verses":[{"k":"99:1","ar":"إِذَا زُلۡزِلَتِ ٱلۡأَرۡضُ زِلۡزَالَهَا","s":"اذا زلزلت الارض زلزالها","w":[{"i":1,"ar":"إِذَا"},{"i":2,"ar":"زُلۡزِلَتِ"},{"i":3,"ar":"ٱلۡأَرۡضُ"},{"i":4,"ar":"زِلۡزَالَهَا"}]},{"k":"99:2","ar":"وَأَخۡرَجَتِ ٱلۡأَرۡضُ أَثۡقَالَهَا","s":"واخرجت الارض اثقالها","w":[{"i":1,"ar":"وَأَخۡرَجَتِ"},{"i":2,"ar":"ٱلۡأَرۡضُ"},{"i":3,"ar":"أَثۡقَالَهَا"}]},{"k":"99:3","ar":"وَقَالَ ٱلۡإِنسَٰنُ مَا لَهَا","s":"وقال الانسن ما لها","w":[{"i":1,"ar":"وَقَالَ"},{"i":2,"ar":"ٱلۡإِنسَٰنُ"},{"i":3,"ar":"مَا"},{"i":4,"ar":"لَهَا"}]},{"k":"99:4","ar":"يَوۡمَئِذࣲ تُحَدِّثُ أَخۡبَارَهَا","s":"يوميذ تحدث اخبارها","w":[{"i":1,"ar":"يَوۡمَئِذࣲ"},{"i":2,"ar":"تُحَدِّثُ"},{"i":3,"ar":"أَخۡبَارَهَا"}]},{"k":"99:5","ar":"بِأَنَّ رَبَّكَ أَوۡحَىٰ لَهَا","s":"بان ربك اوحي لها","w":[{"i":1,"ar":"بِأَنَّ"},{"i":2,"ar":"رَبَّكَ"},{"i":3,"ar":"أَوۡحَىٰ"},{"i":4,"ar":"لَهَا"}]},{"k":"99:6","ar":"يَوۡمَئِذࣲ يَصۡدُرُ ٱلنَّاسُ أَشۡتَاتࣰ ا لِّيُرَوۡاْ أَعۡمَٰلَهُمۡ","s":"يوميذ يصدر الناس اشتات ا ليروا اعملهم","w":[{"i":1,"ar":"يَوۡمَئِذࣲ"},{"i":2,"ar":"يَصۡدُرُ"},{"i":3,"ar":"ٱلنَّاسُ"},{"i":4,"ar":"أَشۡتَاتࣰ"},{"i":5,"ar":"ا"},{"i":6,"ar":"لِّيُرَوۡاْ"},{"i":7,"ar":"أَعۡمَٰلَهُمۡ"}]},{"k":"99:7","ar":"فَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٍ خَيۡرࣰ ا يَرَهُۥ","s":"فمن يعمل مثقال ذره خير ا يره","w":[{"i":1,"ar":"فَمَن"},{"i":2,"ar":"يَعۡمَلۡ"},{"i":3,"ar":"مِثۡقَالَ"},{"i":4,"ar":"ذَرَّةٍ"},{"i":5,"ar":"خَيۡرࣰ"},{"i":6,"ar":"ا"},{"i":7,"ar":"يَرَهُۥ"}]},{"k":"99:8","ar":"وَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةࣲ شَرࣰّ ا يَرَهُۥ","s":"ومن يعمل مثقال ذره شر ا يره","w":[{"i":1,"ar":"وَمَن"},{"i":2,"ar":"يَعۡمَلۡ"},{"i":3,"ar":"مِثۡقَالَ"},{"i":4,"ar":"ذَرَّةࣲ"},{"i":5,"ar":"شَرࣰّ"},{"i":6,"ar":"ا"},{"i":7,"ar":"يَرَهُۥ"}]}]}
{"id":101,"verses":[{"k":"101:1","ar":"ٱلۡقَارِعَةُ","s":"القارعه","w":[{"i":1,"ar":"ٱلۡقَارِعَةُ"}]},{"k":"101:2","ar":"مَا ٱلۡقَارِعَةُ","s":"ما القارعه","w":[{"i":1,"ar":"مَا"},{"i":2,"ar":"ٱلۡقَارِعَةُ"}]},{"k":"101:3","ar":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","s":"وما ادريك ما القارعه","w":[{"i":1,"ar":"وَمَآ"},{"i":2,"ar":"أَدۡرَىٰكَ"},{"i":3,"ar":"مَا"},{"i":4,"ar":"ٱلۡقَارِعَةُ"}]},{"k":"101:4","ar":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","s":"يوم يكون الناس كالفراش المبثوث","w":[{"i":1,"ar":"يَوۡمَ"},{"i":2,"ar":"يَكُونُ"},{"i":3,"ar":"ٱلنَّاسُ"},{"i":4,"ar":"كَٱلۡفَرَاشِ"},{"i":5,"ar":"ٱلۡمَبۡثُوثِ"}]},{"k":"101:5","ar":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","s":"وتكون الجبال كالعهن المنفوش","w":[{"i":1,"ar":"وَتَكُونُ"},{"i":2,"ar":"ٱلۡجِبَالُ"},{"i":3,"ar":"كَٱلۡعِهۡنِ"},{"i":4,"ar":"ٱلۡمَنفُوشِ"}]},{"k":"101:6","ar":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","s":"فاما من ثقلت موزينه","w":[{"i":1,"ar":"فَأَمَّا"},{"i":2,"ar":"مَن"},{"i":3,"ar":"ثَقُلَتۡ"},{"i":4,"ar":"مَوَٰزِينُهُۥ"}]},{"k":"101:7","ar":"فَهُوَ فِي عِيشَةࣲ رَّاضِيَةࣲ‏","s":"فهو في عيشه راضيه‏","w":[{"i":1,"ar":"فَهُوَ"},{"i":2,"ar":"فِي"},{"i":3,"ar":"عِيشَةࣲ"},{"i":4,"ar":"رَّاضِيَةࣲ‏"}]},{"k":"101:8","ar":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ","s":"واما من خفت موزينه","w":[{"i":1,"ar":"وَأَمَّا"},{"i":2,"ar":"مَنۡ"},{"i":3,"ar":"خَفَّتۡ"},{"i":4,"ar":"مَوَٰزِينُهُۥ"}]},{"k":"101:9","ar":"فَأُمُّهُۥ هَاوِيَةࣱ‏","s":"فامه هاويه‏","w":[{"i":1,"ar":"فَأُمُّهُۥ"},{"i":2,"ar":"هَاوِيَةࣱ‏"}]},{"k":"101:10","ar":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ","s":"وما ادريك ما هيه","w":[{"i":1,"ar":"وَمَآ"},{"i":2,"ar":"أَدۡرَىٰكَ"},{"i":3,"ar":"مَا"},{"i":4,"ar":"هِيَهۡ"}]},{"k":"101:11","ar":"نَارٌ حَامِيَةُۢ","s":"نار حاميه","w":[{"i":1,"ar":"نَارٌ"},{"i":2,"ar":"حَامِيَةُۢ"}]}]}
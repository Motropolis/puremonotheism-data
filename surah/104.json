{"id":104,"verses":[{"k":"104:1","ar":"وَيۡلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ","s":"ويل لكل همزه لمزه","w":[{"i":1,"ar":"وَيۡلࣱ"},{"i":2,"ar":"لِّكُلِّ"},{"i":3,"ar":"هُمَزَةࣲ"},{"i":4,"ar":"لُّمَزَةٍ"}]},{"k":"104:2","ar":"ٱلَّذِي جَمَعَ مَالࣰ ا وَعَدَّدَهُۥ","s":"الذي جمع مال ا وعدده","w":[{"i":1,"ar":"ٱلَّذِي"},{"i":2,"ar":"جَمَعَ"},{"i":3,"ar":"مَالࣰ"},{"i":4,"ar":"ا"},{"i":5,"ar":"وَعَدَّدَهُۥ"}]},{"k":"104:3","ar":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ","s":"يحسب ان ماله اخلده","w":[{"i":1,"ar":"يَحۡسَبُ"},{"i":2,"ar":"أَنَّ"},{"i":3,"ar":"مَالَهُۥٓ"},{"i":4,"ar":"أَخۡلَدَهُۥ"}]},{"k":"104:4","ar":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ","s":"كلا لينبذن في الحطمه","w":[{"i":1,"ar":"كَلَّاۖ"},{"i":2,"ar":"لَيُنۢبَذَنَّ"},{"i":3,"ar":"فِي"},{"i":4,"ar":"ٱلۡحُطَمَةِ"}]},{"k":"104:5","ar":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ","s":"وما ادريك ما الحطمه","w":[{"i":1,"ar":"وَمَآ"},{"i":2,"ar":"أَدۡرَىٰكَ"},{"i":3,"ar":"مَا"},{"i":4,"ar":"ٱلۡحُطَمَةُ"}]},{"k":"104:6","ar":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ","s":"نار الله الموقده","w":[{"i":1,"ar":"نَارُ"},{"i":2,"ar":"ٱللَّهِ"},{"i":3,"ar":"ٱلۡمُوقَدَةُ"}]},{"k":"104:7","ar":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ","s":"التي تطلع علي الافده","w":[{"i":1,"ar":"ٱلَّتِي"},{"i":2,"ar":"تَطَّلِعُ"},{"i":3,"ar":"عَلَى"},{"i":4,"ar":"ٱلۡأَفۡـِٔدَةِ"}]},{"k":"104:8","ar":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةࣱ‏","s":"انها عليهم موصده‏","w":[{"i":1,"ar":"إِنَّهَا"},{"i":2,"ar":"عَلَيۡهِم"},{"i":3,"ar":"مُّؤۡصَدَةࣱ‏"}]},{"k":"104:9","ar":"فِي عَمَدࣲ مُّمَدَّدَةِۭ","s":"في عمد ممدده","w":[{"i":1,"ar":"فِي"},{"i":2,"ar":"عَمَدࣲ"},{"i":3,"ar":"مُّمَدَّدَةِۭ"}]}]}
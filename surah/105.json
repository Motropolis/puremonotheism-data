{"id":105,"verses":[{"k":"105:1","ar":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ","s":"الم تر كيف فعل ربك باصحب الفيل","w":[{"i":1,"ar":"أَلَمۡ"},{"i":2,"ar":"تَرَ"},{"i":3,"ar":"كَيۡفَ"},{"i":4,"ar":"فَعَلَ"},{"i":5,"ar":"رَبُّكَ"},{"i":6,"ar":"بِأَصۡحَٰبِ"},{"i":7,"ar":"ٱلۡفِيلِ"}]},{"k":"105:2","ar":"أَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِي تَضۡلِيلࣲ‏","s":"الم يجعل كيدهم في تضليل‏","w":[{"i":1,"ar":"أَلَمۡ"},{"i":2,"ar":"يَجۡعَلۡ"},{"i":3,"ar":"كَيۡدَهُمۡ"},{"i":4,"ar":"فِي"},{"i":5,"ar":"تَضۡلِيلࣲ‏"}]},{"k":"105:3","ar":"وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ","s":"وارسل عليهم طيرا ابابيل","w":[{"i":1,"ar":"وَأَرۡسَلَ"},{"i":2,"ar":"عَلَيۡهِمۡ"},{"i":3,"ar":"طَيۡرًا"},{"i":4,"ar":"أَبَابِيلَ"}]},{"k":"105:4","ar":"تَرۡمِيهِم بِحِجَارَةࣲ مِّن سِجِّيلࣲ‏","s":"ترميهم بحجاره من سجيل‏","w":[{"i":1,"ar":"تَرۡمِيهِم"},{"i":2,"ar":"بِحِجَارَةࣲ"},{"i":3,"ar":"مِّن"},{"i":4,"ar":"سِجِّيلࣲ‏"}]},{"k":"105:5","ar":"فَجَعَلَهُمۡ كَعَصۡفࣲ مَّأۡكُولِۭ","s":"فجعلهم كعصف ماكول","w":[{"i":1,"ar":"فَجَعَلَهُمۡ"},{"i":2,"ar":"كَعَصۡفࣲ"},{"i":3,"ar":"مَّأۡكُولِۭ"}]}]}
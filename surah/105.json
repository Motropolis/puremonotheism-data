{"id":105,"verses":[{"k":"105:1","ar":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ","s":"الم تر كيف فعل ربك باصحب الفيل","w":[{"i":1,"ar":"أَلَمۡ","lem":"لَم","pos":"P"},{"i":2,"ar":"تَرَ","r":"r-a-y","ra":"رأي","lem":"رَأَى","pos":"V"},{"i":3,"ar":"كَيۡفَ","r":"k-y-f","ra":"كيف","lem":"كَيْف","pos":"N"},{"i":4,"ar":"فَعَلَ","r":"f-3-l","ra":"فعل","lem":"فَعَلَ","pos":"V"},{"i":5,"ar":"رَبُّكَ","r":"r-b-b","ra":"ربب","lem":"رَبّ","pos":"N"},{"i":6,"ar":"بِأَصۡحَٰبِ","r":"s6-h7-b","ra":"صحب","lem":"أَصْحاب","pos":"N"},{"i":7,"ar":"ٱلۡفِيلِ","r":"f-y-l","ra":"فيل","lem":"فِيل","pos":"N"}]},{"k":"105:2","ar":"أَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِي تَضۡلِيلࣲ‏","s":"الم يجعل كيدهم في تضليل‏","w":[{"i":1,"ar":"أَلَمۡ","lem":"لَم","pos":"P"},{"i":2,"ar":"يَجۡعَلۡ","r":"j-3-l","ra":"جعل","lem":"جَعَلَ","pos":"V"},{"i":3,"ar":"كَيۡدَهُمۡ","r":"k-y-d","ra":"كيد","lem":"كَيْد","pos":"N"},{"i":4,"ar":"فِي","lem":"فِي","pos":"P"},{"i":5,"ar":"تَضۡلِيلࣲ‏","r":"d6-l-l","ra":"ضلل","lem":"تَضْلِيل","pos":"N"}]},{"k":"105:3","ar":"وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ","s":"وارسل عليهم طيرا ابابيل","w":[{"i":1,"ar":"وَأَرۡسَلَ","r":"r-s-l","ra":"رسل","lem":"أَرْسَلَ","pos":"V"},{"i":2,"ar":"عَلَيۡهِمۡ","lem":"عَلَى","pos":"P"},{"i":3,"ar":"طَيۡرًا","r":"t6-y-r","ra":"طير","lem":"طَيْر","pos":"N"},{"i":4,"ar":"أَبَابِيلَ","r":"a-b-l","ra":"أبل","lem":"أَبابِيل","pos":"N"}]},{"k":"105:4","ar":"تَرۡمِيهِم بِحِجَارَةࣲ مِّن سِجِّيلࣲ‏","s":"ترميهم بحجاره من سجيل‏","w":[{"i":1,"ar":"تَرۡمِيهِم","r":"r-m-y","ra":"رمي","lem":"رَمَى","pos":"V"},{"i":2,"ar":"بِحِجَارَةࣲ","r":"h7-j-r","ra":"حجر","lem":"حِجارَة","pos":"N"},{"i":3,"ar":"مِّن","lem":"مِن","pos":"P"},{"i":4,"ar":"سِجِّيلࣲ‏","r":"s-j-l","ra":"سجل","lem":"سِجِّيل","pos":"N"}]},{"k":"105:5","ar":"فَجَعَلَهُمۡ كَعَصۡفࣲ مَّأۡكُولِۭ","s":"فجعلهم كعصف ماكول","w":[{"i":1,"ar":"فَجَعَلَهُمۡ","r":"j-3-l","ra":"جعل","lem":"جَعَلَ","pos":"V"},{"i":2,"ar":"كَعَصۡفࣲ","r":"3-s6-f","ra":"عصف","lem":"عَصْف","pos":"N"},{"i":3,"ar":"م
{"id":109,"verses":[{"k":"109:1","ar":"قُلۡ يَٰٓأَيُّهَا ٱلۡكَٰفِرُونَ","s":"قل يايها الكفرون","w":[{"i":1,"ar":"قُلۡ"},{"i":2,"ar":"يَٰٓأَيُّهَا"},{"i":3,"ar":"ٱلۡكَٰفِرُونَ"}]},{"k":"109:2","ar":"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ","s":"لا اعبد ما تعبدون","w":[{"i":1,"ar":"لَآ"},{"i":2,"ar":"أَعۡبُدُ"},{"i":3,"ar":"مَا"},{"i":4,"ar":"تَعۡبُدُونَ"}]},{"k":"109:3","ar":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","s":"ولا انتم عبدون ما اعبد","w":[{"i":1,"ar":"وَلَآ"},{"i":2,"ar":"أَنتُمۡ"},{"i":3,"ar":"عَٰبِدُونَ"},{"i":4,"ar":"مَآ"},{"i":5,"ar":"أَعۡبُدُ"}]},{"k":"109:4","ar":"وَلَآ أَنَا۠ عَابِدࣱ مَّا عَبَدتُّمۡ","s":"ولا انا عابد ما عبدتم","w":[{"i":1,"ar":"وَلَآ"},{"i":2,"ar":"أَنَا۠"},{"i":3,"ar":"عَابِدࣱ"},{"i":4,"ar":"مَّا"},{"i":5,"ar":"عَبَدتُّمۡ"}]},{"k":"109:5","ar":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","s":"ولا انتم عبدون ما اعبد","w":[{"i":1,"ar":"وَلَآ"},{"i":2,"ar":"أَنتُمۡ"},{"i":3,"ar":"عَٰبِدُونَ"},{"i":4,"ar":"مَآ"},{"i":5,"ar":"أَعۡبُدُ"}]},{"k":"109:6","ar":"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ","s":"لكم دينكم ولي دين","w":[{"i":1,"ar":"لَكُمۡ"},{"i":2,"ar":"دِينُكُمۡ"},{"i":3,"ar":"وَلِيَ"},{"i":4,"ar":"دِينِ"}]}]}
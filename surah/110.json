{"id":110,"verses":[{"k":"110:1","ar":"إِذَا جَآءَ نَصۡرُ ٱللَّهِ وَٱلۡفَتۡحُ","s":"اذا جاء نصر الله والفتح","w":[{"i":1,"ar":"إِذَا"},{"i":2,"ar":"جَآءَ"},{"i":3,"ar":"نَصۡرُ"},{"i":4,"ar":"ٱللَّهِ"},{"i":5,"ar":"وَٱلۡفَتۡحُ"}]},{"k":"110:2","ar":"وَرَأَيۡتَ ٱلنَّاسَ يَدۡخُلُونَ فِي دِينِ ٱللَّهِ أَفۡوَاجࣰ ا","s":"ورايت الناس يدخلون في دين الله افواج ا","w":[{"i":1,"ar":"وَرَأَيۡتَ"},{"i":2,"ar":"ٱلنَّاسَ"},{"i":3,"ar":"يَدۡخُلُونَ"},{"i":4,"ar":"فِي"},{"i":5,"ar":"دِينِ"},{"i":6,"ar":"ٱللَّهِ"},{"i":7,"ar":"أَفۡوَاجࣰ"},{"i":8,"ar":"ا"}]},{"k":"110:3","ar":"فَسَبِّحۡ بِحَمۡدِ رَبِّكَ وَٱسۡتَغۡفِرۡهُۚ إِنَّهُۥ كَانَ تَوَّابَۢا","s":"فسبح بحمد ربك واستغفره انه كان توابا","w":[{"i":1,"ar":"فَسَبِّحۡ"},{"i":2,"ar":"بِحَمۡدِ"},{"i":3,"ar":"رَبِّكَ"},{"i":4,"ar":"وَٱسۡتَغۡفِرۡهُۚ"},{"i":5,"ar":"إِنَّهُۥ"},{"i":6,"ar":"كَانَ"},{"i":7,"ar":"تَوَّابَۢا"}]}]}
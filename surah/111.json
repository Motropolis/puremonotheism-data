{"id":111,"verses":[{"k":"111:1","ar":"تَبَّتۡ يَدَآ أَبِي لَهَبࣲ وَتَبَّ","s":"تبت يدا ابي لهب وتب","w":[{"i":1,"ar":"تَبَّتۡ"},{"i":2,"ar":"يَدَآ"},{"i":3,"ar":"أَبِي"},{"i":4,"ar":"لَهَبࣲ"},{"i":5,"ar":"وَتَبَّ"}]},{"k":"111:2","ar":"مَآ أَغۡنَىٰ عَنۡهُ مَالُهُۥ وَمَا كَسَبَ","s":"ما اغني عنه ماله وما كسب","w":[{"i":1,"ar":"مَآ"},{"i":2,"ar":"أَغۡنَىٰ"},{"i":3,"ar":"عَنۡهُ"},{"i":4,"ar":"مَالُهُۥ"},{"i":5,"ar":"وَمَا"},{"i":6,"ar":"كَسَبَ"}]},{"k":"111:3","ar":"سَيَصۡلَىٰ نَارࣰ ا ذَاتَ لَهَبࣲ‏","s":"سيصلي نار ا ذات لهب‏","w":[{"i":1,"ar":"سَيَصۡلَىٰ"},{"i":2,"ar":"نَارࣰ"},{"i":3,"ar":"ا"},{"i":4,"ar":"ذَاتَ"},{"i":5,"ar":"لَهَبࣲ‏"}]},{"k":"111:4","ar":"وَٱمۡرَأَتُهُۥ حَمَّالَةَ ٱلۡحَطَبِ","s":"وامراته حماله الحطب","w":[{"i":1,"ar":"وَٱمۡرَأَتُهُۥ"},{"i":2,"ar":"حَمَّالَةَ"},{"i":3,"ar":"ٱلۡحَطَبِ"}]},{"k":"111:5","ar":"فِي جِيدِهَا حَبۡلࣱ مِّن مَّسَدِۭ","s":"في جيدها حبل من مسد","w":[{"i":1,"ar":"فِي"},{"i":2,"ar":"جِيدِهَا"},{"i":3,"ar":"حَبۡلࣱ"},{"i":4,"ar":"مِّن"},{"i":5,"ar":"مَّسَدِۭ"}]}]}